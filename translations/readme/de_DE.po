msgid ""
msgstr ""
"Project-Id-Version: NitroSearch for WooCommerce readme\n"
"PO-Revision-Date: 2026-08-02 16:16+0000\n"
"Last-Translator: NitroSearch Team <hello@nitrosearch.io>\n"
"Language: de_DE\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
