msgstr "Disimpan. Mengindeks halaman Anda di latar belakang."


msgid "Saved. Indexing your blog posts in the background."
msgstr "Disimpan. Mengindeks pos blog Anda di latar belakang."


msgid "Disconnected."
msgstr "Sambungan diputus."


msgid "This store is already claimed to a NitroSearch account."
msgstr "Toko ini sudah diklaim ke sebuah akun NitroSearch."


#. translators: "Refresh status" is the button of that name on this screen — translate it the same way.
msgid "We couldn’t confirm control of your site yet — click \"Refresh status\" first, then try again."
msgstr "Kami belum dapat mengonfirmasi kendali atas situs Anda — klik \"Segarkan status\" terlebih dahulu, lalu coba lagi."


#. translators: "Refresh status" is the button of that name on this screen — translate it the same way.
msgid "Your site needs re-checking — click \"Refresh status\", then try again."
msgstr "Situs Anda perlu diperiksa ulang — klik \"Segarkan status\", lalu coba lagi."


msgid "Too many attempts — please wait a minute and try again."
msgstr "Terlalu banyak percobaan — harap tunggu sekitar satu menit, lalu coba lagi."


msgid "Could not create a manage link. Please try again."
msgstr "Tidak dapat membuat tautan pengelolaan. Silakan coba lagi."


msgid "Insufficient permissions."
msgstr "Izin tidak mencukupi."


