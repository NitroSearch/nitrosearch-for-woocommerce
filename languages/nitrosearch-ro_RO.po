msgstr "Căutarea este indisponibilă."


msgid "Search is unavailable right now."
msgstr "Momentan căutarea este indisponibilă."


msgid "No products found."
msgstr "Nu am găsit niciun produs."


#. translators: %s: the shopper's search term.
msgid "No products found for “%s”."
msgstr "Nu am găsit niciun produs pentru „%s”."


#. translators: %s: the shopper's search term.
msgid "Nothing found for “%s”."
msgstr "Nu am găsit nimic pentru „%s”."


msgid "Search products…"
msgstr "Caută produse…"


msgid "Close search"
msgstr "Închide căutarea"


msgid "Product results"
msgstr "Rezultate pentru produse"


