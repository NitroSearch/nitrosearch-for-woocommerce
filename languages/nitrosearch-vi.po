#. Plugin Name of the plugin
msgid "NitroSearch for WooCommerce"
msgstr "NitroSearch for WooCommerce"


#. Plugin URI of the plugin
msgid "https://nitrosearch.io"
msgstr "https://nitrosearch.io"


#. Description of the plugin
msgid "Blazing-fast hosted search for WooCommerce. Syncs your catalog to NitroSearch and replaces the default WordPress search with instant, typo-tolerant results."
msgstr "Tìm kiếm đám mây siêu nhanh cho WooCommerce. Đồng bộ danh mục sản phẩm của bạn lên NitroSearch và thay thế tìm kiếm mặc định của WordPress bằng kết quả tức thì, chấp nhận lỗi chính tả."


#. Author of the plugin
msgid "WebDeviant"
msgstr "WebDeviant"


#. Author URI of the plugin
msgid "https://webdeviant.io"
msgstr "https://webdeviant.io"


msgid "<strong>NitroSearch now measures how your store's search performs</strong> — anonymous, cookieless counts of searches and result clicks, with no shopper identifiers. It helps result ranking improve, and per-store reporting is on the roadmap."
msgstr "<strong>NitroSearch giờ đây đo lường hiệu quả tìm kiếm trên cửa hàng của bạn</strong> — đếm ẩn danh, không dùng cookie số lượt tìm kiếm và lượt nhấp vào kết quả, không có bất kỳ định danh nào của người mua. Dữ liệu này giúp cải thiện thứ hạng kết quả, và báo cáo theo từng cửa hàng đang nằm trong lộ trình phát triển."


#. translators: %s: a link to the NitroSearch settings screen, labeled "NitroSearch → Appearance".
msgid "Manage it under %s."
msgstr "Quản lý tính năng này trong %s."


msgid "NitroSearch → Appearance"
msgstr "NitroSearch → Giao diện"


msgid "Dismiss"
msgstr "Bỏ qua"


msgid "Unauthorized."
msgstr "Không được phép."


msgid "Not connected"
msgstr "Chưa kết nối"


msgid "Confirming control…"
msgstr "Đang xác nhận quyền kiểm soát…"


msgid "Connected & verified"
msgstr "Đã kết nối & xác minh"


msgid "Amazon-quality search for WooCommerce"
msgstr "Tìm kiếm chất lượng chuẩn Amazon cho WooCommerce"


msgid "Connect your store"
msgstr "Kết nối cửa hàng của bạn"


msgid "Connect this store to NitroSearch to start syncing your catalog and serving instant, typo-tolerant search. Nothing leaves your site until you click Connect."
msgstr "Kết nối cửa hàng này với NitroSearch để bắt đầu đồng bộ danh mục sản phẩm và cung cấp tìm kiếm tức thì, chấp nhận lỗi chính tả. Không có dữ liệu nào rời khỏi trang của bạn cho đến khi bạn nhấp vào Kết nối."


msgid "Provisioning token"
msgstr "Token cấp phát"


msgid "Optional. Only needed if you were given a token to connect this store."
msgstr "Không bắt buộc. Chỉ cần nếu bạn được cấp token để kết nối cửa hàng này."


msgid "Connect store"
msgstr "Kết nối cửa hàng"


msgid "Confirming control of your site…"
msgstr "Đang xác nhận quyền kiểm soát trang của bạn…"


msgid "We’re verifying that you control this store before building your search index. In production this is automatic; if your site isn’t reachable from our servers it can take a moment. Your catalog syncs as soon as it’s confirmed."
msgstr "Chúng tôi đang xác minh rằng bạn kiểm soát cửa hàng này trước khi xây dựng chỉ mục tìm kiếm. Trong môi trường thực tế, việc này diễn ra tự động; nếu máy chủ của chúng tôi không truy cập được trang của bạn, quá trình có thể mất một lúc. Danh mục sản phẩm sẽ được đồng bộ ngay khi xác nhận xong."


msgid "Check status"
msgstr "Kiểm tra trạng thái"


msgid "Disconnect"
msgstr "Ngắt kết nối"


msgid "Dashboard"
msgstr "Bảng tin"


msgid "Design"
msgstr "Thiết kế"


msgid "You’ve reached your plan’s limit."
msgstr "Bạn đã chạm giới hạn của gói dịch vụ."


#. translators: %s: the "Manage / Upgrade" button label, wrapped in <em>. Translate it the same way as the button.
msgid "Your search keeps running for everything already indexed, but new items won’t be added until you upgrade. Your products always take priority, so anything held back is a page or a post. Open %s below to move to a bigger plan."
msgstr "Tìm kiếm của bạn vẫn chạy với mọi thứ đã được lập chỉ mục, nhưng mục mới sẽ không được thêm vào cho đến khi bạn nâng cấp. Sản phẩm của bạn luôn được ưu tiên, nên những gì bị giữ lại chỉ là trang hoặc bài viết. Mở %s bên dưới để chuyển sang gói lớn hơn."


msgid "Manage / Upgrade"
msgstr "Quản lý / Nâng cấp"


msgid "Sync health"
msgstr "Tình trạng đồng bộ"


msgid "Search results indexed"
msgstr "Kết quả tìm kiếm đã lập chỉ mục"


msgid "Unlimited"
msgstr "Không giới hạn"


msgid "Pending changes"
msgstr "Thay đổi đang chờ"


msgid "Last sync"
msgstr "Đồng bộ lần cuối"


msgid "Never"
msgstr "Chưa bao giờ"


msgid "Last error"
msgstr "Lỗi gần nhất"


msgid "Sync all products"
msgstr "Đồng bộ tất cả sản phẩm"


msgid "Refresh status"
msgstr "Làm mới trạng thái"


#. translators: %s: a human-readable time interval, e.g. "4 mins".
msgid "%s from now"
msgstr "%s nữa"


msgid "On demand"
msgstr "Theo yêu cầu"


msgctxt "unit: milliseconds"
msgid "ms"
msgstr "ms"


msgid "Sync performance"
msgstr "Hiệu suất đồng bộ"


msgid "Avg sync speed"
msgstr "Tốc độ đồng bộ trung bình"


msgid "Last batch"
msgstr "Lô gần nhất"


msgid "Items synced"
msgstr "Số mục đã đồng bộ"


msgid "Batches sent"
msgstr "Số lô đã gửi"


msgid "Next sync"
msgstr "Đồng bộ tiếp theo"


msgid "Changes to your catalog are batched and pushed in the background — these figures show how quickly they reach your search index."
msgstr "Các thay đổi trong danh mục sản phẩm được gom thành lô và đẩy đi trong nền — những con số này cho thấy chúng đến chỉ mục tìm kiếm của bạn nhanh đến mức nào."


msgid "Search analytics"
msgstr "Phân tích tìm kiếm"


msgid "last 30 days"
msgstr "30 ngày qua"


msgid "Couldn’t load analytics just now — it will retry automatically."
msgstr "Không tải được dữ liệu phân tích ngay lúc này — hệ thống sẽ tự động thử lại."


#. translators: 1: "N searches" (already localized), shown in bold. 2: the entry price of the cheapest paid plan (always billed in US dollars).
msgid "<strong>%1$s</strong> on your store in the last 30 days. See what shoppers searched for, what they clicked, and what they looked for and didn’t find — included on every paid plan, from %2$s."
msgstr "<strong>%1$s</strong> trên cửa hàng của bạn trong 30 ngày qua. Xem người mua đã tìm gì, nhấp vào gì, và tìm gì mà không thấy — có sẵn trong mọi gói trả phí, từ %2$s."


#. translators: %s: number of searches.
msgid "%s search"
msgid_plural "%s searches"
msgstr[0] "%s lượt tìm kiếm"


#. translators: %s: a price in US dollars, e.g. "$5.99". "mo" is short for month.
msgid "%s/mo"
msgstr "%s/tháng"


msgid "Upgrade to unlock"
msgstr "Nâng cấp để mở khóa"


msgid "Analytics starts collecting with plugin 1.5.0+ active — data appears within a few hours of shoppers searching."
msgstr "Phân tích bắt đầu thu thập khi plugin phiên bản 1.5.0 trở lên hoạt động — dữ liệu xuất hiện trong vòng vài giờ sau khi người mua tìm kiếm."


msgid "Searches"
msgstr "Lượt tìm kiếm"


msgid "Zero-result rate"
msgstr "Tỷ lệ không có kết quả"


msgid "Click-through"
msgstr "Tỷ lệ nhấp"


msgid "Top searches"
msgstr "Tìm kiếm nhiều nhất"


msgid "Searched, found nothing"
msgstr "Đã tìm, không thấy gì"


msgid "View full analytics →"
msgstr "Xem phân tích đầy đủ →"


msgid "Your plan & account"
msgstr "Gói dịch vụ & tài khoản của bạn"


msgid "This store is claimed to a NitroSearch account. Manage your plan and billing from your NitroSearch dashboard."
msgstr "Cửa hàng này đã được gắn với một tài khoản NitroSearch. Quản lý gói dịch vụ và thanh toán từ bảng điều khiển NitroSearch của bạn."


msgid "You're on the <strong>Free</strong> plan. Claim this store to a NitroSearch account to manage it or upgrade — your index and search stay exactly as they are."
msgstr "Bạn đang dùng gói <strong>Miễn phí</strong>. Gắn cửa hàng này với một tài khoản NitroSearch để quản lý hoặc nâng cấp — chỉ mục và tìm kiếm của bạn vẫn giữ nguyên như hiện tại."


msgid "Roomy"
msgstr "Rộng rãi"


msgid "Two-line names and a clear picture. The default."
msgstr "Tên sản phẩm hai dòng kèm hình ảnh rõ ràng. Đây là mặc định."


msgid "Compact"
msgstr "Nhỏ gọn"


msgid "Smaller rows, so more products fit before scrolling."
msgstr "Hàng nhỏ hơn, hiển thị được nhiều sản phẩm hơn trước khi phải cuộn."


msgid "Big pictures"
msgstr "Hình lớn"


msgid "Larger thumbnails for image-led catalogs."
msgstr "Ảnh thu nhỏ lớn hơn, dành cho danh mục thiên về hình ảnh."


msgid "Text only"
msgstr "Chỉ chữ"


msgid "No pictures — good for spare parts and B2B."
msgstr "Không có hình — phù hợp với phụ tùng, linh kiện và B2B."


msgid "Light"
msgstr "Sáng"


msgid "A white panel. Suits most themes."
msgstr "Khung nền trắng. Hợp với hầu hết giao diện."


msgid "Dark"
msgstr "Tối"


msgid "A dark panel, for dark headers and themes."
msgstr "Khung nền tối, dành cho phần đầu trang và giao diện tối màu."


msgid "Automatic"
msgstr "Tự động"


msgid "Follows each shopper's own device setting."
msgstr "Theo thiết lập trên thiết bị của từng người mua."


msgid "Custom"
msgstr "Tùy chỉnh"


msgid "Choose your own panel and text colors below."
msgstr "Tự chọn màu nền khung và màu chữ ở bên dưới."


msgid "Look"
msgstr "Diện mạo"


msgid "Layout"
msgstr "Bố cục"


msgid "Products shown"
msgstr "Số sản phẩm hiển thị"


msgid "How many products appear in the drop-down as your shopper types."
msgstr "Số sản phẩm xuất hiện trong khung thả xuống khi người mua gõ tìm kiếm."


msgid "Filters"
msgstr "Bộ lọc"


msgid "Automatic (recommended)"
msgstr "Tự động (khuyên dùng)"


msgid "Always across the top"
msgstr "Luôn nằm ngang trên cùng"


msgid "Hide in the drop-down"
msgstr "Ẩn trong khung thả xuống"


msgid "In stock, on sale, brand and category filters. Automatic puts them in a side column when there is room, and across the top when there is not."
msgstr "Các bộ lọc còn hàng, đang giảm giá, thương hiệu và danh mục. Chế độ Tự động đặt chúng ở cột bên khi đủ chỗ, và nằm ngang trên cùng khi không đủ."


msgid "Drop-down width"
msgstr "Chiều rộng khung thả xuống"


msgid "Wide"
msgstr "Rộng"


msgid "Match my search box"
msgstr "Khớp với ô tìm kiếm của tôi"


msgid "Automatic gives product names enough room to read, even when your theme's search box is narrow. Match my search box keeps it exactly as wide as the box."
msgstr "Chế độ Tự động cho tên sản phẩm đủ chỗ để đọc, ngay cả khi ô tìm kiếm của giao diện khá hẹp. Khớp với ô tìm kiếm của tôi giữ khung đúng bằng chiều rộng của ô."


msgid "Colors"
msgstr "Màu sắc"


msgid "Color scheme"
msgstr "Bảng màu"


msgid "Accent color"
msgstr "Màu nhấn"


msgid "Used for prices, highlights and selected filters. Leave blank for the default. Text on top of it is set to black or white automatically, whichever stays readable."
msgstr "Dùng cho giá, phần nhấn mạnh và bộ lọc đang được chọn. Để trống để dùng màu mặc định. Chữ nằm trên màu này tự động chuyển thành đen hoặc trắng, tùy màu nào dễ đọc hơn."


msgid "Panel background"
msgstr "Màu nền khung"


msgid "Only used when the color scheme is set to Custom."
msgstr "Chỉ dùng khi bảng màu được đặt là Tùy chỉnh."


msgid "Text color"
msgstr "Màu chữ"


msgid "Corners"
msgstr "Góc bo"


msgid "Rounded"
msgstr "Bo tròn"


msgid "Slightly rounded"
msgstr "Bo nhẹ"


msgid "Square"
msgstr "Vuông"


msgid "Text style"
msgstr "Kiểu chữ"


msgid "Match my store"
msgstr "Khớp với cửa hàng của tôi"


msgid "System default"
msgstr "Mặc định hệ thống"


msgid "Custom font"
msgstr "Phông chữ tùy chỉnh"


msgid "Match my store borrows the font your theme already uses around the search box."
msgstr "Khớp với cửa hàng của tôi dùng lại phông chữ mà giao diện của bạn đang dùng quanh ô tìm kiếm."


msgctxt "example font stack"
msgid "e.g. Georgia, serif"
msgstr "ví dụ: Georgia, serif"


msgid "Only used when Custom font is selected."
msgstr "Chỉ dùng khi chọn Phông chữ tùy chỉnh."


msgid "What to search"
msgstr "Phạm vi tìm kiếm"


msgid "Include"
msgstr "Bao gồm"


msgid "Products"
msgstr "Sản phẩm"


msgid "always indexed"
msgstr "luôn được lập chỉ mục"


msgid "Pages"
msgstr "Trang"


msgid "Blog posts"
msgstr "Bài viết"


#. translators: %s: the technical term "noindex", wrapped in <em>. Do not translate it.
msgid "Pages and posts count toward the same allowance as your products, so switching them off frees it up for your catalog. Your products always come first and are never displaced by them. Private, password-protected and unpublished content is never indexed, and we honor %s set by Yoast SEO or Rank Math (per item, per content type, or site-wide)."
msgstr "Trang và bài viết được tính chung hạn mức với sản phẩm của bạn, nên tắt chúng sẽ giải phóng hạn mức cho danh mục sản phẩm. Sản phẩm luôn đứng trước và không bao giờ bị chúng chiếm chỗ. Nội dung riêng tư, được bảo vệ bằng mật khẩu hoặc chưa đăng không bao giờ được lập chỉ mục, và chúng tôi tôn trọng %s do Yoast SEO hoặc Rank Math đặt (theo từng mục, từng loại nội dung, hoặc toàn trang)."


msgid "Search results page"
msgstr "Trang kết quả tìm kiếm"


msgid "Enhance the product search results page with NitroSearch results and filters"
msgstr "Nâng cấp trang kết quả tìm kiếm sản phẩm bằng kết quả và bộ lọc NitroSearch"


msgid "Privacy &amp; credit"
msgstr "Quyền riêng tư &amp; ghi công"


msgid "Search usage data"
msgstr "Dữ liệu sử dụng tìm kiếm"


msgid "Share anonymous search usage counts with NitroSearch"
msgstr "Chia sẻ số liệu sử dụng tìm kiếm ẩn danh với NitroSearch"


msgid "Counts searches, result totals and result clicks on your store's search — cookieless and anonymous, with no shopper identifiers, no IP addresses and nothing stored in the shopper's browser. Used to improve result ranking and to power your search analytics. Uncheck to stop sending immediately."
msgstr "Đếm số lượt tìm kiếm, tổng số kết quả và lượt nhấp vào kết quả trên tìm kiếm của cửa hàng bạn — không dùng cookie và hoàn toàn ẩn danh, không có định danh người mua, không có địa chỉ IP và không lưu gì trong trình duyệt của người mua. Dùng để cải thiện thứ hạng kết quả và cung cấp dữ liệu cho phân tích tìm kiếm của bạn. Bỏ chọn để dừng gửi ngay lập tức."


msgid "Powered-by credit"
msgstr "Dòng ghi công"


msgid "Show a small “Powered by NitroSearch” credit, linking to nitrosearch.io"
msgstr "Hiển thị dòng ghi công nhỏ “Được cung cấp bởi NitroSearch”, liên kết đến nitrosearch.io"


#. translators: %s: the URL https://nitrosearch.io, wrapped in <code>.
msgid "Off by default, and entirely your choice. Turning it on adds a small credit in the search box and one line in your site footer, both linking to %s — a normal, followed link. Nothing is added to your site unless you check this. Thank you if you do."
msgstr "Tắt theo mặc định, và hoàn toàn do bạn quyết định. Bật lên sẽ thêm một dòng ghi công nhỏ trong ô tìm kiếm và một dòng ở chân trang, cả hai liên kết đến %s — một liên kết bình thường, dạng dofollow. Không có gì được thêm vào trang của bạn trừ khi bạn đánh dấu chọn. Cảm ơn bạn nếu bạn bật."


msgid "Advanced"
msgstr "Nâng cao"


msgid "Search box selector"
msgstr "Bộ chọn ô tìm kiếm"


msgctxt "example CSS selector"
msgid "e.g. input.my-theme-search"
msgstr "ví dụ: input.my-theme-search"


msgid "Optional CSS selector for your theme's search input. Leave blank to auto-detect."
msgstr "Bộ chọn CSS tùy chọn cho ô nhập tìm kiếm của giao diện. Để trống để tự động nhận diện."


msgid "Save design"
msgstr "Lưu thiết kế"


#. translators: %s: the error detail returned by the server.
msgid "Connect failed: %s"
msgstr "Kết nối thất bại: %s"


msgid "unknown error"
msgstr "lỗi không xác định"


msgid "Connected and verified."
msgstr "Đã kết nối và xác minh."


msgid "Connected. Confirming control of your site — this can take a moment. Use “Check status” below if it doesn’t update."
msgstr "Đã kết nối. Đang xác nhận quyền kiểm soát trang của bạn — việc này có thể mất một lúc. Dùng “Kiểm tra trạng thái” bên dưới nếu trạng thái không tự cập nhật."


#. translators: %s: number of products.
msgid "Syncing %s product in the background, then your pages and posts."
msgid_plural "Syncing %s products in the background, then your pages and posts."
msgstr[0] "Đang đồng bộ %s sản phẩm trong nền, sau đó đến trang và bài viết của bạn."


#. translators: %s: number of products.
msgid "Syncing %s product in the background."
msgid_plural "Syncing %s products in the background."
msgstr[0] "Đang đồng bộ %s sản phẩm trong nền."


msgid "Verified!"
msgstr "Đã xác minh!"


#. translators: 1: number of items in the search index, 2: number of changes waiting to sync.
msgid "%1$s search results indexed · %2$s pending."
msgstr "%1$s kết quả tìm kiếm đã được lập chỉ mục · %2$s đang chờ."


msgid "Still confirming control of your site — please try again in a moment."
msgstr "Vẫn đang xác nhận quyền kiểm soát trang của bạn — vui lòng thử lại sau giây lát."


msgid "Design saved."
msgstr "Đã lưu thiết kế."


msgid "Saved. Removing your pages and blog posts from your index in the background."
msgstr "Đã lưu. Đang gỡ trang và bài viết của bạn khỏi chỉ mục trong nền."


msgid "Saved. Removing your pages from your index in the background."
msgstr "Đã lưu. Đang gỡ trang của bạn khỏi chỉ mục trong nền."


msgid "Saved. Removing your blog posts from your index in the background."
msgstr "Đã lưu. Đang gỡ bài viết của bạn khỏi chỉ mục trong nền."


msgid "Saved. Indexing your pages and blog posts in the background."
msgstr "Đã lưu. Đang lập chỉ mục trang và bài viết của bạn trong nền."


msgid "Saved. Indexing your pages in the background."
msgstr "Đã lưu. Đang lập chỉ mục trang của bạn trong nền."


msgid "Saved. Indexing your blog posts in the background."
msgstr "Đã lưu. Đang lập chỉ mục bài viết của bạn trong nền."


msgid "Disconnected."
msgstr "Đã ngắt kết nối."


msgid "This store is already claimed to a NitroSearch account."
msgstr "Cửa hàng này đã được gắn với một tài khoản NitroSearch."


