msgstr "%1$s arama sonucu dizine eklendi · %2$s beklemede."


msgid "Still confirming control of your site — please try again in a moment."
msgstr "Sitenizin denetimi hâlâ doğrulanıyor — lütfen birazdan yeniden deneyin."


msgid "Design saved."
msgstr "Tasarım kaydedildi."


msgid "Saved. Removing your pages and blog posts from your index in the background."
msgstr "Kaydedildi. Sayfalarınız ve blog yazılarınız arka planda dizininizden kaldırılıyor."


msgid "Saved. Removing your pages from your index in the background."
msgstr "Kaydedildi. Sayfalarınız arka planda dizininizden kaldırılıyor."


msgid "Saved. Removing your blog posts from your index in the background."
msgstr "Kaydedildi. Blog yazılarınız arka planda dizininizden kaldırılıyor."


msgid "Saved. Indexing your pages and blog posts in the background."
msgstr "Kaydedildi. Sayfalarınız ve blog yazılarınız arka planda dizine ekleniyor."


msgid "Saved. Indexing your pages in the background."
msgstr "Kaydedildi. Sayfalarınız arka planda dizine ekleniyor."


msgid "Saved. Indexing your blog posts in the background."
msgstr "Kaydedildi. Blog yazılarınız arka planda dizine ekleniyor."


msgid "Disconnected."
msgstr "Bağlantı kesildi."


msgid "This store is already claimed to a NitroSearch account."
msgstr "Bu mağaza zaten bir NitroSearch hesabına bağlanmış."


#. translators: "Refresh status" is the button of that name on this screen — translate it the same way.
msgid "We couldn’t confirm control of your site yet — click \"Refresh status\" first, then try again."
msgstr "Sitenizin denetimini henüz doğrulayamadık — önce \"Durumu yenile\" düğmesine tıklayın, sonra yeniden deneyin."


#. translators: "Refresh status" is the button of that name on this screen — translate it the same way.
msgid "Your site needs re-checking — click \"Refresh status\", then try again."
msgstr "Sitenizin yeniden denetlenmesi gerekiyor — \"Durumu yenile\" düğmesine tıklayın, sonra yeniden deneyin."


msgid "Too many attempts — please wait a minute and try again."
msgstr "Çok fazla deneme yapıldı — lütfen bir dakika bekleyip yeniden deneyin."


msgid "Could not create a manage link. Please try again."
msgstr "Yönetim bağlantısı oluşturulamadı. Lütfen yeniden deneyin."


msgid "Insufficient permissions."
msgstr "Yeterli izniniz yok."


