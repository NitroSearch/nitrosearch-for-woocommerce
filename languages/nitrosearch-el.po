#. Plugin Name of the plugin
msgid "NitroSearch for WooCommerce"
msgstr "NitroSearch for WooCommerce"


#. Plugin URI of the plugin
msgid "https://nitrosearch.io"
msgstr "https://nitrosearch.io"


#. Description of the plugin
msgid "Blazing-fast hosted search for WooCommerce. Syncs your catalog to NitroSearch and replaces the default WordPress search with instant, typo-tolerant results."
msgstr "Αστραπιαία φιλοξενούμενη αναζήτηση για το WooCommerce. Συγχρονίζει τον κατάλογό σας με το NitroSearch και αντικαθιστά την προεπιλεγμένη αναζήτηση του WordPress με άμεσα αποτελέσματα που ανέχονται τα ορθογραφικά λάθη."


#. Author of the plugin
msgid "WebDeviant"
msgstr "WebDeviant"


#. Author URI of the plugin
msgid "https://webdeviant.io"
msgstr "https://webdeviant.io"


msgid "<strong>NitroSearch now measures how your store's search performs</strong> — anonymous, cookieless counts of searches and result clicks, with no shopper identifiers. It helps result ranking improve, and per-store reporting is on the roadmap."
msgstr "<strong>Το NitroSearch μετρά πλέον την απόδοση της αναζήτησης του καταστήματός σας</strong> — ανώνυμες μετρήσεις αναζητήσεων και κλικ στα αποτελέσματα, χωρίς cookies και χωρίς στοιχεία ταυτοποίησης αγοραστών. Βοηθά στη βελτίωση της κατάταξης των αποτελεσμάτων, ενώ οι αναφορές ανά κατάστημα βρίσκονται στον σχεδιασμό μας."


#. translators: %s: a link to the NitroSearch settings screen, labelled "NitroSearch → Appearance".
msgid "Manage it under %s."
msgstr "Μπορείτε να το διαχειριστείτε από το %s."


msgid "NitroSearch → Appearance"
msgstr "NitroSearch → Εμφάνιση"


msgid "Dismiss"
msgstr "Απόρριψη"


msgid "Unauthorized."
msgstr "Χωρίς εξουσιοδότηση."


msgid "Not connected"
msgstr "Μη συνδεδεμένο"


msgid "Confirming control…"
msgstr "Επιβεβαίωση ελέγχου…"


msgid "Connected & verified"
msgstr "Συνδεδεμένο & επαληθευμένο"


msgid "Amazon-quality search for WooCommerce"
msgstr "Αναζήτηση ποιότητας Amazon για το WooCommerce"


msgid "Connect your store"
msgstr "Συνδέστε το κατάστημά σας"


msgid "Connect this store to NitroSearch to start syncing your catalogue and serving instant, typo-tolerant search. Nothing leaves your site until you click Connect."
msgstr "Συνδέστε αυτό το κατάστημα με το NitroSearch για να ξεκινήσει ο συγχρονισμός του καταλόγου σας και η άμεση αναζήτηση με ανοχή στα ορθογραφικά λάθη. Τίποτα δεν φεύγει από τον ιστότοπό σας μέχρι να πατήσετε «Σύνδεση»."


msgid "Provisioning token"
msgstr "Διακριτικό ενεργοποίησης"


msgid "Optional. Only needed if you were given a token to connect this store."
msgstr "Προαιρετικό. Χρειάζεται μόνο αν σας έχει δοθεί διακριτικό για τη σύνδεση αυτού του καταστήματος."


msgid "Connect store"
msgstr "Σύνδεση καταστήματος"


msgid "Confirming control of your site…"
msgstr "Επιβεβαίωση ελέγχου του ιστοτόπου σας…"


msgid "We’re verifying that you control this store before building your search index. In production this is automatic; if your site isn’t reachable from our servers it can take a moment. Your catalogue syncs as soon as it’s confirmed."
msgstr "Επαληθεύουμε ότι ελέγχετε αυτό το κατάστημα πριν δημιουργήσουμε το ευρετήριο αναζήτησής σας. Σε κανονική λειτουργία αυτό γίνεται αυτόματα· αν ο ιστότοπός σας δεν είναι προσβάσιμος από τους διακομιστές μας, μπορεί να χρειαστεί λίγη ώρα. Ο κατάλογός σας συγχρονίζεται μόλις ολοκληρωθεί η επιβεβαίωση."


msgid "Check status"
msgstr "Έλεγχος κατάστασης"


msgid "Disconnect"
msgstr "Αποσύνδεση"


msgid "Dashboard"
msgstr "Πίνακας ελέγχου"


msgid "Design"
msgstr "Σχεδίαση"


msgid "You’ve reached your plan’s limit."
msgstr "Φτάσατε το όριο του προγράμματός σας."


#. translators: %s: the "Manage / Upgrade" button label, wrapped in <em>. Translate it the same way as the button.
msgid "Your search keeps running for everything already indexed, but new items won’t be added until you upgrade. Your products always take priority, so anything held back is a page or a post. Open %s below to move to a bigger plan."
msgstr "Η αναζήτησή σας συνεχίζει να λειτουργεί για ό,τι έχει ήδη ευρετηριαστεί, αλλά νέα στοιχεία δεν θα προστίθενται μέχρι να αναβαθμίσετε. Τα προϊόντα σας έχουν πάντα προτεραιότητα, οπότε ό,τι μένει εκτός είναι κάποια σελίδα ή κάποιο άρθρο. Ανοίξτε το %s παρακάτω για να μεταβείτε σε μεγαλύτερο πρόγραμμα."


msgid "Manage / Upgrade"
msgstr "Διαχείριση / Αναβάθμιση"


msgid "Sync health"
msgstr "Κατάσταση συγχρονισμού"


msgid "Search results indexed"
msgstr "Αποτελέσματα αναζήτησης στο ευρετήριο"


msgid "Unlimited"
msgstr "Απεριόριστα"


msgid "Pending changes"
msgstr "Εκκρεμείς αλλαγές"


msgid "Last sync"
msgstr "Τελευταίος συγχρονισμός"


msgid "Never"
msgstr "Ποτέ"


msgid "Last error"
msgstr "Τελευταίο σφάλμα"


msgid "Sync all products"
msgstr "Συγχρονισμός όλων των προϊόντων"


msgid "Refresh status"
msgstr "Ανανέωση κατάστασης"


#. translators: %s: a human-readable time interval, e.g. "4 mins".
msgid "%s from now"
msgstr "%s από τώρα"


msgid "On demand"
msgstr "Κατ’ απαίτηση"


msgctxt "unit: milliseconds"
msgid "ms"
msgstr "ms"


msgid "Sync performance"
msgstr "Επιδόσεις συγχρονισμού"


msgid "Avg sync speed"
msgstr "Μέση ταχύτητα συγχρονισμού"


msgid "Last batch"
msgstr "Τελευταία παρτίδα"


msgid "Items synced"
msgstr "Συγχρονισμένα στοιχεία"


msgid "Batches sent"
msgstr "Απεσταλμένες παρτίδες"


msgid "Next sync"
msgstr "Επόμενος συγχρονισμός"


msgid "Changes to your catalogue are batched and pushed in the background — these figures show how quickly they reach your search index."
msgstr "Οι αλλαγές στον κατάλογό σας ομαδοποιούνται και αποστέλλονται στο παρασκήνιο — αυτά τα μεγέθη δείχνουν πόσο γρήγορα φτάνουν στο ευρετήριο αναζήτησής σας."


msgid "Search analytics"
msgstr "Αναλυτικά στοιχεία αναζήτησης"


msgid "last 30 days"
msgstr "τελευταίες 30 ημέρες"


msgid "Couldn’t load analytics just now — it will retry automatically."
msgstr "Δεν ήταν δυνατή η φόρτωση των αναλυτικών στοιχείων αυτήν τη στιγμή — θα γίνει αυτόματη νέα προσπάθεια."


#. translators: 1: "N searches" (already localized), shown in bold. 2: the entry price of the cheapest paid plan (always billed in US dollars).
msgid "<strong>%1$s</strong> on your store in the last 30 days. See what shoppers searched for, what they clicked, and what they looked for and didn’t find — included on every paid plan, from %2$s."
msgstr "<strong>%1$s</strong> στο κατάστημά σας τις τελευταίες 30 ημέρες. Δείτε τι αναζήτησαν οι αγοραστές, πού έκαναν κλικ και τι έψαξαν χωρίς να το βρουν — περιλαμβάνεται σε κάθε πρόγραμμα επί πληρωμή, από %2$s."


#. translators: %s: number of searches.
msgid "%s search"
msgid_plural "%s searches"
msgstr[0] "%s αναζήτηση"
msgstr[1] "%s αναζητήσεις"


#. translators: %s: a price in US dollars, e.g. "$5.99". "mo" is short for month.
msgid "%s/mo"
msgstr "%s/μήνα"


msgid "Upgrade to unlock"
msgstr "Αναβαθμίστε για να ξεκλειδώσετε"


msgid "Analytics starts collecting with plugin 1.5.0+ active — data appears within a few hours of shoppers searching."
msgstr "Η συλλογή αναλυτικών στοιχείων ξεκινά με ενεργό το πρόσθετο 1.5.0+ — τα δεδομένα εμφανίζονται μέσα σε λίγες ώρες από τις αναζητήσεις των αγοραστών."


msgid "Searches"
msgstr "Αναζητήσεις"


msgid "Zero-result rate"
msgstr "Ποσοστό μηδενικών αποτελεσμάτων"


msgid "Click-through"
msgstr "Ποσοστό κλικ"


msgid "Top searches"
msgstr "Κορυφαίες αναζητήσεις"


msgid "Searched, found nothing"
msgstr "Αναζήτησαν, δεν βρήκαν τίποτα"


msgid "View full analytics →"
msgstr "Δείτε τα πλήρη αναλυτικά στοιχεία →"


msgid "Your plan & account"
msgstr "Το πρόγραμμα και ο λογαριασμός σας"


msgid "This store is claimed to a NitroSearch account. Manage your plan and billing from your NitroSearch dashboard."
msgstr "Αυτό το κατάστημα έχει αντιστοιχιστεί σε λογαριασμό NitroSearch. Διαχειριστείτε το πρόγραμμα και τις χρεώσεις σας από τον πίνακα ελέγχου του NitroSearch."


msgid "You're on the <strong>Free</strong> plan. Claim this store to a NitroSearch account to manage it or upgrade — your index and search stay exactly as they are."
msgstr "Βρίσκεστε στο <strong>δωρεάν</strong> πρόγραμμα. Αντιστοιχίστε αυτό το κατάστημα σε έναν λογαριασμό NitroSearch για να το διαχειρίζεστε ή να αναβαθμίσετε — το ευρετήριο και η αναζήτησή σας μένουν ακριβώς όπως είναι."


msgid "Roomy"
msgstr "Άνετη"


msgid "Two-line names and a clear picture. The default."
msgstr "Ονόματα σε δύο γραμμές και καθαρή εικόνα. Η προεπιλογή."


msgid "Compact"
msgstr "Συμπαγής"


msgid "Smaller rows, so more products fit before scrolling."
msgstr "Μικρότερες σειρές, ώστε να χωρούν περισσότερα προϊόντα πριν από την κύλιση."


msgid "Big pictures"
msgstr "Μεγάλες εικόνες"


msgid "Larger thumbnails for image-led catalogues."
msgstr "Μεγαλύτερες μικρογραφίες για καταλόγους που βασίζονται στην εικόνα."


msgid "Text only"
msgstr "Μόνο κείμενο"


msgid "No pictures — good for spares, parts and B2B."
msgstr "Χωρίς εικόνες — ιδανικό για ανταλλακτικά, εξαρτήματα και B2B."


msgid "Light"
msgstr "Ανοιχτό"


msgid "A white panel. Suits most themes."
msgstr "Ένα λευκό πάνελ. Ταιριάζει στα περισσότερα θέματα."


msgid "Dark"
msgstr "Σκούρο"


msgid "A dark panel, for dark headers and themes."
msgstr "Ένα σκούρο πάνελ, για σκούρες κεφαλίδες και θέματα."


msgid "Automatic"
msgstr "Αυτόματο"


msgid "Follows each shopper's own device setting."
msgstr "Ακολουθεί τη ρύθμιση της συσκευής του κάθε αγοραστή."


msgid "Custom"
msgstr "Προσαρμοσμένο"


msgid "Choose your own panel and text colours below."
msgstr "Επιλέξτε παρακάτω τα δικά σας χρώματα για το πάνελ και το κείμενο."


msgid "Look"
msgstr "Όψη"


msgid "Layout"
msgstr "Διάταξη"


msgid "Products shown"
msgstr "Εμφανιζόμενα προϊόντα"


msgid "How many products appear in the drop-down as your shopper types."
msgstr "Πόσα προϊόντα εμφανίζονται στο αναπτυσσόμενο πλαίσιο καθώς πληκτρολογεί ο αγοραστής σας."


msgid "Filters"
msgstr "Φίλτρα"


msgid "Automatic (recommended)"
msgstr "Αυτόματο (προτείνεται)"


msgid "Always across the top"
msgstr "Πάντα στο επάνω μέρος"


msgid "Hide in the drop-down"
msgstr "Απόκρυψη στο αναπτυσσόμενο πλαίσιο"


msgid "In stock, on sale, brand and category filters. Automatic puts them in a side column when there is room, and across the top when there is not."
msgstr "Φίλτρα αποθέματος, προσφορών, μάρκας και κατηγορίας. Η επιλογή «Αυτόματο» τα τοποθετεί σε πλαϊνή στήλη όταν υπάρχει χώρος και στο επάνω μέρος όταν δεν υπάρχει."


msgid "Drop-down width"
msgstr "Πλάτος αναπτυσσόμενου πλαισίου"


msgid "Wide"
msgstr "Πλατύ"


msgid "Match my search box"
msgstr "Ίδιο με το πεδίο αναζήτησής μου"


msgid "Automatic gives product names enough room to read, even when your theme's search box is narrow. Match my search box keeps it exactly as wide as the box."
msgstr "Η επιλογή «Αυτόματο» δίνει στα ονόματα των προϊόντων αρκετό χώρο για να διαβάζονται, ακόμη κι όταν το πεδίο αναζήτησης του θέματός σας είναι στενό. Η επιλογή «Ίδιο με το πεδίο αναζήτησής μου» το κρατά ακριβώς όσο πλατύ είναι το πεδίο."


msgid "Colours"
msgstr "Χρώματα"


msgid "Colour scheme"
msgstr "Συνδυασμός χρωμάτων"


msgid "Accent colour"
msgstr "Χρώμα έμφασης"


msgid "Used for prices, highlights and selected filters. Leave blank for the default. Text on top of it is set to black or white automatically, whichever stays readable."
msgstr "Χρησιμοποιείται για τιμές, επισημάνσεις και επιλεγμένα φίλτρα. Αφήστε το κενό για την προεπιλογή. Το κείμενο επάνω του γίνεται αυτόματα μαύρο ή λευκό, όποιο από τα δύο μένει ευανάγνωστο."


msgid "Panel background"
msgstr "Φόντο πάνελ"


msgid "Only used when the colour scheme is set to Custom."
msgstr "Χρησιμοποιείται μόνο όταν ο συνδυασμός χρωμάτων έχει οριστεί σε «Προσαρμοσμένο»."


msgid "Text colour"
msgstr "Χρώμα κειμένου"


msgid "Corners"
msgstr "Γωνίες"


msgid "Rounded"
msgstr "Στρογγυλεμένες"


msgid "Slightly rounded"
msgstr "Ελαφρώς στρογγυλεμένες"


msgid "Square"
msgstr "Τετράγωνες"


msgid "Text style"
msgstr "Στυλ κειμένου"


msgid "Match my store"
msgstr "Ίδιο με το κατάστημά μου"


msgid "System default"
msgstr "Προεπιλογή συστήματος"


msgid "Custom font"
msgstr "Προσαρμοσμένη γραμματοσειρά"


msgid "Match my store borrows the font your theme already uses around the search box."
msgstr "Η επιλογή «Ίδιο με το κατάστημά μου» δανείζεται τη γραμματοσειρά που χρησιμοποιεί ήδη το θέμα σας γύρω από το πεδίο αναζήτησης."


msgctxt "example font stack"
msgid "e.g. Georgia, serif"
msgstr "π.χ. Georgia, serif"


msgid "Only used when Custom font is selected."
msgstr "Χρησιμοποιείται μόνο όταν είναι επιλεγμένη η «Προσαρμοσμένη γραμματοσειρά»."


msgid "What to search"
msgstr "Τι θα αναζητείται"


msgid "Include"
msgstr "Συμπερίληψη"


msgid "Products"
msgstr "Προϊόντα"


msgid "always indexed"
msgstr "ευρετηριάζονται πάντα"


msgid "Pages"
msgstr "Σελίδες"


msgid "Blog posts"
msgstr "Άρθρα ιστολογίου"


#. translators: %s: the technical term "noindex", wrapped in <em>. Do not translate it.
msgid "Pages and posts count towards the same allowance as your products, so switching them off frees it up for your catalogue. Your products always come first and are never displaced by them. Private, password-protected and unpublished content is never indexed, and we honour %s set by Yoast SEO or Rank Math (per item, per content type, or site-wide)."
msgstr "Οι σελίδες και τα άρθρα μετρούν στο ίδιο όριο με τα προϊόντα σας, οπότε αν τα απενεργοποιήσετε, το απελευθερώνετε για τον κατάλογό σας. Τα προϊόντα σας προηγούνται πάντα και δεν εκτοπίζονται ποτέ από αυτά. Ιδιωτικό, προστατευμένο με συνθηματικό ή μη δημοσιευμένο περιεχόμενο δεν ευρετηριάζεται ποτέ, και σεβόμαστε το %s που ορίζεται από το Yoast SEO ή το Rank Math (ανά στοιχείο, ανά τύπο περιεχομένου ή για όλο τον ιστότοπο)."


msgid "Search results page"
msgstr "Σελίδα αποτελεσμάτων αναζήτησης"


msgid "Enhance the product search results page with NitroSearch results and filters"
msgstr "Εμπλουτισμός της σελίδας αποτελεσμάτων αναζήτησης προϊόντων με αποτελέσματα και φίλτρα του NitroSearch"


msgid "Privacy &amp; credit"
msgstr "Απόρρητο &amp; μνεία"


msgid "Search usage data"
msgstr "Δεδομένα χρήσης αναζήτησης"


msgid "Share anonymous search usage counts with NitroSearch"
msgstr "Κοινοποίηση ανώνυμων μετρήσεων χρήσης της αναζήτησης στο NitroSearch"


msgid "Counts searches, result totals and result clicks on your store's search — cookieless and anonymous, with no shopper identifiers, no IP addresses and nothing stored in the shopper's browser. Used to improve result ranking and to power your search analytics. Untick to stop sending immediately."
msgstr "Μετρά αναζητήσεις, σύνολα αποτελεσμάτων και κλικ στα αποτελέσματα της αναζήτησης του καταστήματός σας — χωρίς cookies και ανώνυμα, χωρίς στοιχεία ταυτοποίησης αγοραστών, χωρίς διευθύνσεις IP και χωρίς να αποθηκεύεται οτιδήποτε στο πρόγραμμα περιήγησης του αγοραστή. Χρησιμοποιείται για τη βελτίωση της κατάταξης των αποτελεσμάτων και για τα αναλυτικά στοιχεία της αναζήτησής σας. Αποεπιλέξτε το για να σταματήσει αμέσως η αποστολή."


msgid "Powered-by credit"
msgstr "Μνεία «Powered by»"


msgid "Show a small “Powered by NitroSearch” credit, linking to nitrosearch.io"
msgstr "Εμφάνιση μιας μικρής μνείας «Με την τεχνολογία του NitroSearch», με σύνδεσμο προς το nitrosearch.io"


#. translators: %s: the URL https://nitrosearch.io, wrapped in <code>.
msgid "Off by default, and entirely your choice. Turning it on adds a small credit in the search box and one line in your site footer, both linking to %s — a normal, followed link. Nothing is added to your site unless you tick this. Thank you if you do."
msgstr "Απενεργοποιημένη από προεπιλογή, και αποκλειστικά δική σας επιλογή. Αν την ενεργοποιήσετε, προστίθεται μια μικρή μνεία στο πεδίο αναζήτησης και μία γραμμή στο υποσέλιδο του ιστοτόπου σας, και οι δύο με σύνδεσμο προς το %s — έναν κανονικό σύνδεσμο, χωρίς nofollow. Τίποτα δεν προστίθεται στον ιστότοπό σας αν δεν το επιλέξετε. Σας ευχαριστούμε αν το κάνετε."


msgid "Advanced"
msgstr "Για προχωρημένους"


msgid "Search box selector"
msgstr "Επιλογέας πεδίου αναζήτησης"


msgctxt "example CSS selector"
msgid "e.g. input.my-theme-search"
msgstr "π.χ. input.my-theme-search"


msgid "Optional CSS selector for your theme's search input. Leave blank to auto-detect."
msgstr "Προαιρετικός επιλογέας CSS για το πεδίο αναζήτησης του θέματός σας. Αφήστε το κενό για αυτόματο εντοπισμό."


msgid "Save design"
msgstr "Αποθήκευση σχεδίασης"


#. translators: %s: the error detail returned by the server.
msgid "Connect failed: %s"
msgstr "Η σύνδεση απέτυχε: %s"


msgid "unknown error"
msgstr "άγνωστο σφάλμα"


msgid "Connected and verified."
msgstr "Συνδέθηκε και επαληθεύτηκε."


msgid "Connected. Confirming control of your site — this can take a moment. Use “Check status” below if it doesn’t update."
msgstr "Συνδέθηκε. Γίνεται επιβεβαίωση του ελέγχου του ιστοτόπου σας — μπορεί να χρειαστεί λίγη ώρα. Αν δεν ενημερωθεί, χρησιμοποιήστε παρακάτω το «Έλεγχος κατάστασης»."


#. translators: %s: number of products.
msgid "Syncing %s product in the background, then your pages and posts."
msgid_plural "Syncing %s products in the background, then your pages and posts."
msgstr[0] "Συγχρονισμός %s προϊόντος στο παρασκήνιο και στη συνέχεια των σελίδων και των άρθρων σας."
msgstr[1] "Συγχρονισμός %s προϊόντων στο παρασκήνιο και στη συνέχεια των σελίδων και των άρθρων σας."


#. translators: %s: number of products.
msgid "Syncing %s product in the background."
msgid_plural "Syncing %s products in the background."
msgstr[0] "Συγχρονισμός %s προϊόντος στο παρασκήνιο."
msgstr[1] "Συγχρονισμός %s προϊόντων στο παρασκήνιο."


msgid "Verified!"
msgstr "Επαληθεύτηκε!"


#. translators: 1: number of items in the search index, 2: number of changes waiting to sync.
msgid "%1$s search results indexed · %2$s pending."
msgstr "%1$s αποτελέσματα αναζήτησης στο ευρετήριο · %2$s σε εκκρεμότητα."


msgid "Still confirming control of your site — please try again in a moment."
msgstr "Η επιβεβαίωση του ελέγχου του ιστοτόπου σας συνεχίζεται — δοκιμάστε ξανά σε λίγο."


msgid "Design saved."
msgstr "Η σχεδίαση αποθηκεύτηκε."


msgid "Saved. Removing your pages and blog posts from your index in the background."
msgstr "Αποθηκεύτηκε. Οι σελίδες και τα άρθρα ιστολογίου σας αφαιρούνται από το ευρετήριό σας στο παρασκήνιο."


msgid "Saved. Removing your pages from your index in the background."
msgstr "Αποθηκεύτηκε. Οι σελίδες σας αφαιρούνται από το ευρετήριό σας στο παρασκήνιο."


