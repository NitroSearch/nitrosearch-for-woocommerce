#. Plugin Name of the plugin
msgid "NitroSearch for WooCommerce"
msgstr "NitroSearch for WooCommerce"

#. Plugin URI of the plugin
msgid "https://nitrosearch.io"
msgstr "https://nitrosearch.io"

#. Description of the plugin
msgid "Blazing-fast hosted search for WooCommerce. Syncs your catalog to NitroSearch and replaces the default WordPress search with instant, typo-tolerant results."
msgstr "Pesquisa alojada ultrarrápida para WooCommerce. Sincroniza o seu catálogo com o NitroSearch e substitui a pesquisa predefinida do WordPress por resultados instantâneos e tolerantes a gralhas."

#. Author of the plugin
msgid "WebDeviant"
msgstr "WebDeviant"

#. Author URI of the plugin
msgid "https://webdeviant.io"
msgstr "https://webdeviant.io"

msgid "<strong>NitroSearch now measures how your store's search performs</strong> — anonymous, cookieless counts of searches and result clicks, with no shopper identifiers. It helps result ranking improve, and per-store reporting is on the roadmap."
msgstr "<strong>O NitroSearch agora mede o desempenho da pesquisa da sua loja</strong> — contagens anónimas e sem cookies das pesquisas e dos cliques nos resultados, sem identificadores de clientes. Ajuda a melhorar a ordenação dos resultados, e os relatórios por loja estão no nosso plano de desenvolvimento."

#. translators: %s: a link to the NitroSearch settings screen, labeled "NitroSearch → Appearance".
msgid "Manage it under %s."
msgstr "Pode gerir esta opção em %s."

msgid "NitroSearch → Appearance"
msgstr "NitroSearch → Aspeto"

msgid "Dismiss"
msgstr "Ignorar"

msgid "Unauthorized."
msgstr "Não autorizado."

msgid "Not connected"
msgstr "Não ligada"

msgid "Confirming control…"
msgstr "A confirmar o controlo…"

msgid "Connected & verified"
msgstr "Ligada e verificada"

msgid "Amazon-quality search for WooCommerce"
msgstr "Pesquisa com a qualidade da Amazon para o WooCommerce"

msgid "Connect your store"
msgstr "Ligue a sua loja"

msgid "Connect this store to NitroSearch to start syncing your catalog and serving instant, typo-tolerant search. Nothing leaves your site until you click Connect."
msgstr "Ligue esta loja ao NitroSearch para começar a sincronizar o seu catálogo e a servir uma pesquisa instantânea e tolerante a gralhas. Nada sai do seu site até clicar em Ligar loja."

msgid "Provisioning token"
msgstr "Token de aprovisionamento"

msgid "Optional. Only needed if you were given a token to connect this store."
msgstr "Opcional. Apenas necessário se lhe tiver sido fornecido um token para ligar esta loja."

msgid "Connect store"
msgstr "Ligar loja"

msgid "Confirming control of your site…"
msgstr "A confirmar o controlo do seu site…"

msgid "We’re verifying that you control this store before building your search index. In production this is automatic; if your site isn’t reachable from our servers it can take a moment. Your catalog syncs as soon as it’s confirmed."
msgstr "Estamos a confirmar que controla esta loja antes de construirmos o seu índice de pesquisa. Em produção isto é automático; se o seu site não estiver acessível a partir dos nossos servidores, pode demorar um momento. O seu catálogo sincroniza assim que a confirmação estiver concluída."

msgid "Check status"
msgstr "Verificar estado"

msgid "Disconnect"
msgstr "Desligar"

msgid "Dashboard"
msgstr "Painel"

msgid "Design"
msgstr "Design"

msgid "You’ve reached your plan’s limit."
msgstr "Atingiu o limite do seu plano."

#. translators: %s: the "Manage / Upgrade" button label, wrapped in <em>. Translate it the same way as the button.
msgid "Your search keeps running for everything already indexed, but new items won’t be added until you upgrade. Your products always take priority, so anything held back is a page or a post. Open %s below to move to a bigger plan."
msgstr "A sua pesquisa continua a funcionar para tudo o que já está indexado, mas não serão adicionados novos itens até fazer upgrade. Os seus produtos têm sempre prioridade, por isso qualquer item retido é uma página ou um artigo. Abra %s abaixo para mudar para um plano maior."

msgid "Manage / Upgrade"
msgstr "Gerir / Fazer upgrade"

msgid "Sync health"
msgstr "Saúde da sincronização"

msgid "Search results indexed"
msgstr "Resultados de pesquisa indexados"

msgid "Unlimited"
msgstr "Ilimitado"

msgid "Pending changes"
msgstr "Alterações pendentes"

msgid "Last sync"
msgstr "Última sincronização"

msgid "Never"
msgstr "Nunca"

msgid "Last error"
msgstr "Último erro"

msgid "Sync all products"
msgstr "Sincronizar todos os produtos"

msgid "Refresh status"
msgstr "Atualizar estado"

#. translators: %s: a human-readable time interval, e.g. "4 mins".
msgid "%s from now"
msgstr "Daqui a %s"

msgid "On demand"
msgstr "A pedido"

msgctxt "unit: milliseconds"
msgid "ms"
msgstr "ms"

msgid "Sync performance"
msgstr "Desempenho da sincronização"

msgid "Avg sync speed"
msgstr "Velocidade média de sincronização"

msgid "Last batch"
msgstr "Último lote"

msgid "Items synced"
msgstr "Itens sincronizados"

msgid "Batches sent"
msgstr "Lotes enviados"

msgid "Next sync"
msgstr "Próxima sincronização"

msgid "Changes to your catalog are batched and pushed in the background — these figures show how quickly they reach your search index."
msgstr "As alterações ao seu catálogo são agrupadas em lotes e enviadas em segundo plano — estes números mostram a rapidez com que chegam ao seu índice de pesquisa."

msgid "Search analytics"
msgstr "Estatísticas de pesquisa"

msgid "last 30 days"
msgstr "últimos 30 dias"

msgid "Couldn’t load analytics just now — it will retry automatically."
msgstr "Não foi possível carregar as estatísticas neste momento — será feita nova tentativa automaticamente."

#. translators: 1: "N searches" (already localized), shown in bold. 2: the entry price of the cheapest paid plan (always billed in US dollars).
msgid "<strong>%1$s</strong> on your store in the last 30 days. See what shoppers searched for, what they clicked, and what they looked for and didn’t find — included on every paid plan, from %2$s."
msgstr "<strong>%1$s</strong> na sua loja nos últimos 30 dias. Veja o que os clientes pesquisaram, onde clicaram e o que procuraram sem encontrar — incluído em todos os planos pagos, a partir de %2$s."

#. translators: %s: number of searches.
msgid "%s search"
msgid_plural "%s searches"
msgstr[0] "%s pesquisa"
msgstr[1] "%s pesquisas"

#. translators: %s: a price in US dollars, e.g. "$5.99". "mo" is short for month.
msgid "%s/mo"
msgstr "%s/mês"

msgid "Upgrade to unlock"
msgstr "Faça upgrade para desbloquear"

msgid "Analytics starts collecting with plugin 1.5.0+ active — data appears within a few hours of shoppers searching."
msgstr "As estatísticas começam a ser recolhidas com o plugin 1.5.0+ ativo — os dados aparecem poucas horas depois de os clientes pesquisarem."

msgid "Searches"
msgstr "Pesquisas"

msgid "Zero-result rate"
msgstr "Taxa de pesquisas sem resultados"

msgid "Click-through"
msgstr "Taxa de cliques"

msgid "Top searches"
msgstr "Pesquisas mais frequentes"

msgid "Searched, found nothing"
msgstr "Pesquisaram e não encontraram nada"

msgid "View full analytics →"
msgstr "Ver estatísticas completas →"

msgid "Your plan & account"
msgstr "O seu plano e conta"

msgid "This store is claimed to a NitroSearch account. Manage your plan and billing from your NitroSearch dashboard."
msgstr "Esta loja está associada a uma conta NitroSearch. Faça a gestão do seu plano e da faturação a partir do seu painel NitroSearch."

msgid "You're on the <strong>Free</strong> plan. Claim this store to a NitroSearch account to manage it or upgrade — your index and search stay exactly as they are."
msgstr "Está no plano <strong>Gratuito</strong>. Associe esta loja a uma conta NitroSearch para a gerir ou fazer upgrade — o seu índice e a sua pesquisa ficam exatamente como estão."

msgid "Roomy"
msgstr "Espaçoso"

msgid "Two-line names and a clear picture. The default."
msgstr "Nomes em duas linhas e uma imagem bem visível. A predefinição."

msgid "Compact"
msgstr "Compacto"

msgid "Smaller rows, so more products fit before scrolling."
msgstr "Linhas mais pequenas, para caberem mais produtos sem ser preciso deslocar a página."

msgid "Big pictures"
msgstr "Imagens grandes"

msgid "Larger thumbnails for image-led catalogs."
msgstr "Miniaturas maiores, para catálogos centrados na imagem."

msgid "Text only"
msgstr "Só texto"

msgid "No pictures — good for spare parts and B2B."
msgstr "Sem imagens — bom para peças, sobressalentes e B2B."

msgid "Light"
msgstr "Claro"

msgid "A white panel. Suits most themes."
msgstr "Um painel branco. Adequa-se à maioria dos temas."

msgid "Dark"
msgstr "Escuro"

msgid "A dark panel, for dark headers and themes."
msgstr "Um painel escuro, para cabeçalhos e temas escuros."

msgid "Automatic"
msgstr "Automático"

msgid "Follows each shopper's own device setting."
msgstr "Segue a definição do dispositivo de cada cliente."

msgid "Custom"
msgstr "Personalizado"

msgid "Choose your own panel and text colors below."
msgstr "Escolha abaixo as suas próprias cores do painel e do texto."

msgid "Look"
msgstr "Aparência"

msgid "Layout"
msgstr "Layout"

msgid "Products shown"
msgstr "Produtos apresentados"

msgid "How many products appear in the drop-down as your shopper types."
msgstr "Quantos produtos aparecem na lista pendente enquanto o cliente escreve."

msgid "Filters"
msgstr "Filtros"

msgid "Automatic (recommended)"
msgstr "Automático (recomendado)"

msgid "Always across the top"
msgstr "Sempre no topo"

msgid "Hide in the drop-down"
msgstr "Ocultar na lista pendente"

msgid "In stock, on sale, brand and category filters. Automatic puts them in a side column when there is room, and across the top when there is not."
msgstr "Filtros de «Em stock», «Em promoção», marca e categoria. A opção Automático coloca-os numa coluna lateral quando há espaço e no topo quando não há."

msgid "Drop-down width"
msgstr "Largura da lista pendente"

msgid "Wide"
msgstr "Larga"

msgid "Match my search box"
msgstr "Igual à minha caixa de pesquisa"

msgid "Automatic gives product names enough room to read, even when your theme's search box is narrow. Match my search box keeps it exactly as wide as the box."
msgstr "A opção Automático dá aos nomes dos produtos espaço suficiente para serem lidos, mesmo quando a caixa de pesquisa do seu tema é estreita. A opção Igual à minha caixa de pesquisa mantém a lista exatamente com a largura da caixa."

msgid "Colors"
msgstr "Cores"

msgid "Color scheme"
msgstr "Esquema de cores"

msgid "Accent color"
msgstr "Cor de destaque"

msgid "Used for prices, highlights and selected filters. Leave blank for the default. Text on top of it is set to black or white automatically, whichever stays readable."
msgstr "Usada em preços, destaques e filtros selecionados. Deixe em branco para usar a predefinição. O texto por cima desta cor fica automaticamente preto ou branco, conforme o que se mantiver legível."

msgid "Panel background"
msgstr "Fundo do painel"

msgid "Only used when the color scheme is set to Custom."
msgstr "Apenas usado quando o esquema de cores está definido como Personalizado."

msgid "Text color"
msgstr "Cor do texto"

msgid "Corners"
msgstr "Cantos"

msgid "Rounded"
msgstr "Arredondados"

msgid "Slightly rounded"
msgstr "Ligeiramente arredondados"

msgid "Square"
msgstr "Retos"

msgid "Text style"
msgstr "Estilo do texto"

msgid "Match my store"
msgstr "Igual à minha loja"

msgid "System default"
msgstr "Predefinição do sistema"

msgid "Custom font"
msgstr "Tipo de letra personalizado"

msgid "Match my store borrows the font your theme already uses around the search box."
msgstr "A opção Igual à minha loja aproveita o tipo de letra que o seu tema já usa à volta da caixa de pesquisa."

msgctxt "example font stack"
msgid "e.g. Georgia, serif"
msgstr "ex.: Georgia, serif"

msgid "Only used when Custom font is selected."
msgstr "Apenas usado quando a opção Tipo de letra personalizado está selecionada."

msgid "What to search"
msgstr "O que pesquisar"

msgid "Include"
msgstr "Incluir"

msgid "Products"
msgstr "Produtos"

msgid "always indexed"
msgstr "sempre indexados"

msgid "Pages"
msgstr "Páginas"

msgid "Blog posts"
msgstr "Artigos do blog"

#. translators: %s: the technical term "noindex", wrapped in <em>. Do not translate it.
msgid "Pages and posts count toward the same allowance as your products, so switching them off frees it up for your catalog. Your products always come first and are never displaced by them. Private, password-protected and unpublished content is never indexed, and we honor %s set by Yoast SEO or Rank Math (per item, per content type, or site-wide)."
msgstr "As páginas e os artigos contam para o mesmo limite que os seus produtos, por isso desativá-los liberta espaço para o seu catálogo. Os seus produtos vêm sempre primeiro e nunca são deslocados por eles. Conteúdo privado, protegido por palavra-passe ou não publicado nunca é indexado, e respeitamos o %s definido pelo Yoast SEO ou pelo Rank Math (por item, por tipo de conteúdo ou em todo o site)."

msgid "Search results page"
msgstr "Página de resultados de pesquisa"

msgid "Enhance the product search results page with NitroSearch results and filters"
msgstr "Melhorar a página de resultados da pesquisa de produtos com resultados e filtros do NitroSearch"

msgid "Privacy &amp; credit"
msgstr "Privacidade e crédito"

msgid "Search usage data"
msgstr "Dados de utilização da pesquisa"

msgid "Share anonymous search usage counts with NitroSearch"
msgstr "Partilhar contagens anónimas de utilização da pesquisa com o NitroSearch"

msgid "Counts searches, result totals and result clicks on your store's search — cookieless and anonymous, with no shopper identifiers, no IP addresses and nothing stored in the shopper's browser. Used to improve result ranking and to power your search analytics. Uncheck to stop sending immediately."
msgstr "Conta as pesquisas, os totais de resultados e os cliques nos resultados da pesquisa da sua loja — sem cookies e de forma anónima, sem identificadores de clientes, sem endereços IP e sem nada guardado no navegador do cliente. Serve para melhorar a ordenação dos resultados e para alimentar as suas estatísticas de pesquisa. Desmarque para parar o envio de imediato."

msgid "Powered-by credit"
msgstr "Crédito «Com tecnologia»"

msgid "Show a small “Powered by NitroSearch” credit, linking to nitrosearch.io"
msgstr "Mostrar um pequeno crédito «Com tecnologia NitroSearch», com ligação para nitrosearch.io"

#. translators: %s: the URL https://nitrosearch.io, wrapped in <code>.
msgid "Off by default, and entirely your choice. Turning it on adds a small credit in the search box and one line in your site footer, both linking to %s — a normal, followed link. Nothing is added to your site unless you check this. Thank you if you do."
msgstr "Desativado por predefinição, e uma escolha inteiramente sua. Ao ativá-lo, é adicionado um pequeno crédito na caixa de pesquisa e uma linha no rodapé do seu site, ambos com ligação para %s — uma ligação normal, seguida pelos motores de pesquisa. Nada é adicionado ao seu site sem marcar esta opção. Obrigado, se o fizer."

msgid "Advanced"
msgstr "Avançado"

msgid "Search box selector"
msgstr "Seletor da caixa de pesquisa"

msgctxt "example CSS selector"
msgid "e.g. input.my-theme-search"
msgstr "ex.: input.my-theme-search"

msgid "Optional CSS selector for your theme's search input. Leave blank to auto-detect."
msgstr "Seletor CSS opcional para o campo de pesquisa do seu tema. Deixe em branco para detetar automaticamente."

msgid "Save design"
msgstr "Guardar design"

#. translators: %s: the error detail returned by the server.
msgid "Connect failed: %s"
msgstr "Falha ao ligar: %s"

msgid "unknown error"
msgstr "erro desconhecido"

msgid "Connected and verified."
msgstr "Ligada e verificada."

msgid "Connected. Confirming control of your site — this can take a moment. Use “Check status” below if it doesn’t update."
msgstr "Ligada. A confirmar o controlo do seu site — pode demorar um momento. Use «Verificar estado» abaixo se não atualizar."

#. translators: %s: number of products.
msgid "Syncing %s product in the background, then your pages and posts."
msgid_plural "Syncing %s products in the background, then your pages and posts."
msgstr[0] "A sincronizar %s produto em segundo plano e, de seguida, as suas páginas e artigos."
msgstr[1] "A sincronizar %s produtos em segundo plano e, de seguida, as suas páginas e artigos."

#. translators: %s: number of products.
msgid "Syncing %s product in the background."
msgid_plural "Syncing %s products in the background."
msgstr[0] "A sincronizar %s produto em segundo plano."
msgstr[1] "A sincronizar %s produtos em segundo plano."

msgid "Verified!"
msgstr "Verificado!"

#. translators: 1: number of items in the search index, 2: number of changes waiting to sync.
msgid "%1$s search results indexed · %2$s pending."
msgstr "%1$s resultados de pesquisa indexados · %2$s pendentes."

msgid "Still confirming control of your site — please try again in a moment."
msgstr "Ainda a confirmar o controlo do seu site — tente novamente dentro de momentos."

msgid "Design saved."
msgstr "Design guardado."

msgid "Saved. Removing your pages and blog posts from your index in the background."
msgstr "Guardado. A remover as suas páginas e artigos do blog do seu índice em segundo plano."

msgid "Saved. Removing your pages from your index in the background."
msgstr "Guardado. A remover as suas páginas do seu índice em segundo plano."

msgid "Saved. Removing your blog posts from your index in the background."
msgstr "Guardado. A remover os seus artigos do blog do seu índice em segundo plano."

msgid "Saved. Indexing your pages and blog posts in the background."
msgstr "Guardado. A indexar as suas páginas e artigos do blog em segundo plano."

msgid "Saved. Indexing your pages in the background."
msgstr "Guardado. A indexar as suas páginas em segundo plano."

msgid "Saved. Indexing your blog posts in the background."
msgstr "Guardado. A indexar os seus artigos do blog em segundo plano."

msgid "Disconnected."
msgstr "Loja desligada."

msgid "This store is already claimed to a NitroSearch account."
msgstr "Esta loja já está associada a uma conta NitroSearch."

#. translators: "Refresh status" is the button of that name on this screen — translate it the same way.
msgid "We couldn’t confirm control of your site yet — click \"Refresh status\" first, then try again."
msgstr "Ainda não conseguimos confirmar o controlo do seu site — clique primeiro em «Atualizar estado» e tente novamente."

#. translators: "Refresh status" is the button of that name on this screen — translate it the same way.
msgid "Your site needs re-checking — click \"Refresh status\", then try again."
msgstr "O seu site precisa de nova verificação — clique em «Atualizar estado» e tente novamente."

msgid "Too many attempts — please wait a minute and try again."
msgstr "Demasiadas tentativas — aguarde um minuto e tente novamente."

msgid "Could not create a manage link. Please try again."
msgstr "Não foi possível criar uma ligação de gestão. Tente novamente."

msgid "Insufficient permissions."
msgstr "Permissões insuficientes."

#. translators: %s: the linked brand name "NitroSearch".
msgid "Search powered by %s"
msgstr "Pesquisa com tecnologia %s"

msgid "Refine results"
msgstr "Refinar resultados"

msgid "Refine"
msgstr "Refinar"

msgid "In stock"
msgstr "Em stock"

msgid "On sale"
msgstr "Em promoção"

msgid "Brand"
msgstr "Marca"

msgid "Category"
msgstr "Categoria"

msgid "View"
msgstr "Ver"

msgid "Add to cart"
msgstr "Adicionar ao carrinho"

msgid "Adding…"
msgstr "A adicionar…"

msgid "Added ✓"
msgstr "Adicionado ✓"

msgid "Try again"
msgstr "Tentar novamente"

msgid "Searching…"
msgstr "A pesquisar…"

msgid "Search is unavailable."
msgstr "A pesquisa está indisponível."

msgid "Search is unavailable right now."
msgstr "A pesquisa está indisponível neste momento."

msgid "No products found."
msgstr "Não foram encontrados produtos."

#. translators: %s: the shopper's search term.
msgid "No products found for “%s”."
msgstr "Não foram encontrados produtos para «%s»."

#. translators: %s: the shopper's search term.
msgid "Nothing found for “%s”."
msgstr "Não foi encontrado nada para «%s»."

msgid "Search products…"
msgstr "Pesquisar produtos…"

msgid "Close search"
msgstr "Fechar pesquisa"

msgid "Product results"
msgstr "Resultados de produtos"

msgid "Recent searches"
msgstr "Pesquisas recentes"

msgid "Clear"
msgstr "Limpar"

msgid "Start typing to search products…"
msgstr "Comece a escrever para pesquisar produtos…"

msgid "Sale"
msgstr "Promoção"

msgid "Out of stock"
msgstr "Esgotado"

msgid "Pages & posts"
msgstr "Páginas e artigos"

msgctxt "a website page, shown on a search result"
msgid "Page"
msgstr "Página"

msgctxt "a blog post, shown on a search result"
msgid "Article"
msgstr "Artigo"

#. translators: %s: the search round-trip time in milliseconds.
msgctxt "unit: milliseconds"
msgid "%s ms"
msgstr "%s ms"

#. translators: %s: the brand name "NitroSearch".
msgid "Powered by %s"
msgstr "Com tecnologia %s"

#. translators: 1: current page number, 2: total number of pages.
msgid "Page %1$s of %2$s"
msgstr "Página %1$s de %2$s"

msgid "← Prev"
msgstr "← Anterior"

msgid "Next →"
msgstr "Seguinte →"

msgctxt "button label"
msgid "Search"
msgstr "Pesquisar"

#. translators: %s: number of products found (screen-reader announcement).
msgid "%s product found."
msgid_plural "%s products found."
msgstr[0] "Foi encontrado %s produto."
msgstr[1] "Foram encontrados %s produtos."

#. translators: %s: total number of results.
msgid "See all %s result →"
msgid_plural "See all %s results →"
msgstr[0] "Ver %s resultado →"
msgstr[1] "Ver todos os %s resultados →"

#. translators: 1: number of results, 2: the shopper's search term.
msgid "%1$s result for “%2$s”"
msgid_plural "%1$s results for “%2$s”"
msgstr[0] "%1$s resultado para «%2$s»"
msgstr[1] "%1$s resultados para «%2$s»"

#. translators: %s: number of results.
msgid "%s result"
msgid_plural "%s results"
msgstr[0] "%s resultado"
msgstr[1] "%s resultados"

