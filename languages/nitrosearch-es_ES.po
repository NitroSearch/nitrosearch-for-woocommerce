msgstr "Reintentar"

msgid "Searching…"
msgstr "Buscando…"

msgid "Search is unavailable."
msgstr "La búsqueda no está disponible."

msgid "Search is unavailable right now."
msgstr "La búsqueda no está disponible en este momento."

msgid "No products found."
msgstr "No se han encontrado productos."

#. translators: %s: the shopper's search term.
msgid "No products found for “%s”."
msgstr "No se han encontrado productos para «%s»."

#. translators: %s: the shopper's search term.
msgid "Nothing found for “%s”."
msgstr "No se ha encontrado nada para «%s»."

msgid "Search products…"
msgstr "Buscar productos…"

msgid "Close search"
msgstr "Cerrar la búsqueda"

msgid "Product results"
msgstr "Resultados de productos"

msgid "Recent searches"
msgstr "Búsquedas recientes"

msgid "Clear"
msgstr "Borrar"

msgid "Start typing to search products…"
msgstr "Empieza a escribir para buscar productos…"

