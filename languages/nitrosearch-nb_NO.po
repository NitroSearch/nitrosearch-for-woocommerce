#. Plugin Name of the plugin
msgid "NitroSearch for WooCommerce"
msgstr "NitroSearch for WooCommerce"


#. Plugin URI of the plugin
msgid "https://nitrosearch.io"
msgstr "https://nitrosearch.io"


#. Description of the plugin
msgid "Blazing-fast hosted search for WooCommerce. Syncs your catalog to NitroSearch and replaces the default WordPress search with instant, typo-tolerant results."
msgstr "Lynraskt, skybasert søk for WooCommerce. Synkroniserer katalogen din til NitroSearch og erstatter standardsøket i WordPress med umiddelbare resultater som tåler skrivefeil."


#. Author of the plugin
msgid "WebDeviant"
msgstr "WebDeviant"


#. Author URI of the plugin
msgid "https://webdeviant.io"
msgstr "https://webdeviant.io"


msgid "<strong>NitroSearch now measures how your store's search performs</strong> — anonymous, cookieless counts of searches and result clicks, with no shopper identifiers. It helps result ranking improve, and per-store reporting is on the roadmap."
msgstr "<strong>NitroSearch måler nå hvordan søket i butikken din presterer</strong> – anonyme tellinger av søk og resultatklikk, uten informasjonskapsler og uten identifikatorer for kundene. Det bidrar til bedre rangering av resultatene, og rapportering per butikk står på planen."


#. translators: %s: a link to the NitroSearch settings screen, labelled "NitroSearch → Appearance".
msgid "Manage it under %s."
msgstr "Du kan administrere dette under %s."


msgid "NitroSearch → Appearance"
msgstr "NitroSearch → Utseende"


msgid "Dismiss"
msgstr "Avvis"


msgid "Unauthorized."
msgstr "Ikke autorisert."


msgid "Not connected"
msgstr "Ikke tilkoblet"


msgid "Confirming control…"
msgstr "Bekrefter kontroll …"


msgid "Connected & verified"
msgstr "Tilkoblet og bekreftet"


msgid "Amazon-quality search for WooCommerce"
msgstr "Søk i Amazon-klasse for WooCommerce"


msgid "Connect your store"
msgstr "Koble til butikken din"


msgid "Connect this store to NitroSearch to start syncing your catalogue and serving instant, typo-tolerant search. Nothing leaves your site until you click Connect."
msgstr "Koble denne butikken til NitroSearch for å begynne å synkronisere katalogen din og levere umiddelbart søk som tåler skrivefeil. Ingenting forlater nettstedet ditt før du klikker på Koble til."


msgid "Provisioning token"
msgstr "Klargjøringstoken"


msgid "Optional. Only needed if you were given a token to connect this store."
msgstr "Valgfritt. Trengs bare hvis du har fått et token for å koble til denne butikken."


msgid "Connect store"
msgstr "Koble til butikk"


msgid "Confirming control of your site…"
msgstr "Bekrefter kontroll over nettstedet ditt …"


msgid "We’re verifying that you control this store before building your search index. In production this is automatic; if your site isn’t reachable from our servers it can take a moment. Your catalogue syncs as soon as it’s confirmed."
msgstr "Vi bekrefter at du har kontroll over denne butikken før vi bygger søkeindeksen din. På et nettsted i drift skjer dette automatisk; hvis nettstedet ditt ikke kan nås fra serverne våre, kan det ta en liten stund. Katalogen din synkroniseres så snart kontrollen er bekreftet."


msgid "Check status"
msgstr "Sjekk status"


msgid "Disconnect"
msgstr "Koble fra"


msgid "Dashboard"
msgstr "Kontrollpanel"


msgid "Design"
msgstr "Design"


msgid "You’ve reached your plan’s limit."
msgstr "Du har nådd grensen for planen din."


#. translators: %s: the "Manage / Upgrade" button label, wrapped in <em>. Translate it the same way as the button.
msgid "Your search keeps running for everything already indexed, but new items won’t be added until you upgrade. Your products always take priority, so anything held back is a page or a post. Open %s below to move to a bigger plan."
msgstr "Søket fortsetter å virke for alt som allerede er indeksert, men nye elementer legges ikke til før du oppgraderer. Produktene dine har alltid prioritet, så det som holdes tilbake, er en side eller et innlegg. Åpne %s nedenfor for å gå over til en større plan."


msgid "Manage / Upgrade"
msgstr "Administrer / oppgrader"


msgid "Sync health"
msgstr "Synkroniseringsstatus"


msgid "Search results indexed"
msgstr "Indekserte søkeresultater"


msgid "Unlimited"
msgstr "Ubegrenset"


msgid "Pending changes"
msgstr "Ventende endringer"


msgid "Last sync"
msgstr "Siste synkronisering"


msgid "Never"
msgstr "Aldri"


msgid "Last error"
msgstr "Siste feil"


msgid "Sync all products"
msgstr "Synkroniser alle produkter"


msgid "Refresh status"
msgstr "Oppdater status"


#. translators: %s: a human-readable time interval, e.g. "4 mins".
msgid "%s from now"
msgstr "om %s"


msgid "On demand"
msgstr "Ved behov"


msgctxt "unit: milliseconds"
msgid "ms"
msgstr "ms"


msgid "Sync performance"
msgstr "Synkroniseringsytelse"


msgid "Avg sync speed"
msgstr "Gj.sn. synkroniseringshastighet"


msgid "Last batch"
msgstr "Siste pulje"


msgid "Items synced"
msgstr "Elementer synkronisert"


msgid "Batches sent"
msgstr "Puljer sendt"


msgid "Next sync"
msgstr "Neste synkronisering"


msgid "Changes to your catalogue are batched and pushed in the background — these figures show how quickly they reach your search index."
msgstr "Endringer i katalogen din samles i puljer og sendes i bakgrunnen – disse tallene viser hvor raskt de når søkeindeksen din."


msgid "Search analytics"
msgstr "Søkeanalyse"


msgid "last 30 days"
msgstr "siste 30 dager"


msgid "Couldn’t load analytics just now — it will retry automatically."
msgstr "Kunne ikke laste inn analysen akkurat nå – den prøver igjen automatisk."


#. translators: 1: "N searches" (already localized), shown in bold. 2: the entry price of the cheapest paid plan (always billed in US dollars).
msgid "<strong>%1$s</strong> on your store in the last 30 days. See what shoppers searched for, what they clicked, and what they looked for and didn’t find — included on every paid plan, from %2$s."
msgstr "<strong>%1$s</strong> i butikken din de siste 30 dagene. Se hva kundene søkte etter, hva de klikket på, og hva de lette etter uten å finne – inkludert i alle betalte planer, fra %2$s."


#. translators: %s: number of searches.
msgid "%s search"
msgid_plural "%s searches"
msgstr[0] "%s søk"
msgstr[1] "%s søk"


#. translators: %s: a price in US dollars, e.g. "$5.99". "mo" is short for month.
msgid "%s/mo"
msgstr "%s/mnd"


msgid "Upgrade to unlock"
msgstr "Oppgrader for å låse opp"


msgid "Analytics starts collecting with plugin 1.5.0+ active — data appears within a few hours of shoppers searching."
msgstr "Analysen begynner å samle inn data når versjon 1.5.0 eller nyere av utvidelsen er aktiv – dataene vises innen noen timer etter at kundene har søkt."


msgid "Searches"
msgstr "Søk"


msgid "Zero-result rate"
msgstr "Andel uten treff"


msgid "Click-through"
msgstr "Klikkandel"


msgid "Top searches"
msgstr "Toppsøk"


msgid "Searched, found nothing"
msgstr "Søkte, fant ingenting"


msgid "View full analytics →"
msgstr "Se hele analysen →"


msgid "Your plan & account"
msgstr "Din plan og konto"


msgid "This store is claimed to a NitroSearch account. Manage your plan and billing from your NitroSearch dashboard."
msgstr "Denne butikken er knyttet til en NitroSearch-konto. Administrer planen din og faktureringen fra NitroSearch-kontrollpanelet ditt."


msgid "You're on the <strong>Free</strong> plan. Claim this store to a NitroSearch account to manage it or upgrade — your index and search stay exactly as they are."
msgstr "Du er på <strong>Gratis</strong>-planen. Knytt denne butikken til en NitroSearch-konto for å administrere den eller oppgradere – indeksen og søket ditt forblir akkurat som de er."


msgid "Roomy"
msgstr "Romslig"


msgid "Two-line names and a clear picture. The default."
msgstr "Produktnavn over to linjer og et tydelig bilde. Standardvalget."


msgid "Compact"
msgstr "Kompakt"


msgid "Smaller rows, so more products fit before scrolling."
msgstr "Mindre rader, så flere produkter får plass før du må rulle."


msgid "Big pictures"
msgstr "Store bilder"


msgid "Larger thumbnails for image-led catalogues."
msgstr "Større miniatyrbilder for kataloger der bildene er viktigst."


msgid "Text only"
msgstr "Bare tekst"


msgid "No pictures — good for spares, parts and B2B."
msgstr "Ingen bilder – fint for reservedeler, komponenter og B2B."


msgid "Light"
msgstr "Lys"


msgid "A white panel. Suits most themes."
msgstr "Et hvitt panel. Passer de fleste temaer."


msgid "Dark"
msgstr "Mørk"


msgid "A dark panel, for dark headers and themes."
msgstr "Et mørkt panel, for mørke sidehoder og temaer."


msgid "Automatic"
msgstr "Automatisk"


msgid "Follows each shopper's own device setting."
msgstr "Følger enhetsinnstillingen til hver enkelt kunde."


msgid "Custom"
msgstr "Egendefinert"


msgid "Choose your own panel and text colours below."
msgstr "Velg dine egne panel- og tekstfarger nedenfor."


msgid "Look"
msgstr "Utseende"


msgid "Layout"
msgstr "Oppsett"


msgid "Products shown"
msgstr "Produkter som vises"


msgid "How many products appear in the drop-down as your shopper types."
msgstr "Hvor mange produkter som vises i nedtrekkspanelet mens kunden skriver."


msgid "Filters"
msgstr "Filtre"


msgid "Automatic (recommended)"
msgstr "Automatisk (anbefalt)"


msgid "Always across the top"
msgstr "Alltid øverst"


msgid "Hide in the drop-down"
msgstr "Skjul i nedtrekkspanelet"


msgid "In stock, on sale, brand and category filters. Automatic puts them in a side column when there is room, and across the top when there is not."
msgstr "Filtre for på lager, på tilbud, merke og kategori. Automatisk plasserer dem i en sidekolonne når det er plass, og øverst når det ikke er det."


msgid "Drop-down width"
msgstr "Bredde på nedtrekkspanelet"


msgid "Wide"
msgstr "Bred"


msgid "Match my search box"
msgstr "Samme som søkefeltet mitt"


msgid "Automatic gives product names enough room to read, even when your theme's search box is narrow. Match my search box keeps it exactly as wide as the box."
msgstr "Automatisk gir produktnavnene nok plass til å kunne leses, selv når søkefeltet i temaet ditt er smalt. Samme som søkefeltet mitt holder panelet nøyaktig like bredt som feltet."


msgid "Colours"
msgstr "Farger"


msgid "Colour scheme"
msgstr "Fargevalg"


msgid "Accent colour"
msgstr "Aksentfarge"


msgid "Used for prices, highlights and selected filters. Leave blank for the default. Text on top of it is set to black or white automatically, whichever stays readable."
msgstr "Brukes til priser, uthevinger og valgte filtre. La feltet stå tomt for standardfargen. Teksten oppå settes automatisk til svart eller hvit, alt etter hva som holder seg lesbart."


msgid "Panel background"
msgstr "Panelbakgrunn"


msgid "Only used when the colour scheme is set to Custom."
msgstr "Brukes bare når fargevalget er satt til Egendefinert."


msgid "Text colour"
msgstr "Tekstfarge"


msgid "Corners"
msgstr "Hjørner"


msgid "Rounded"
msgstr "Avrundede"


msgid "Slightly rounded"
msgstr "Litt avrundede"


msgid "Square"
msgstr "Skarpe"


msgid "Text style"
msgstr "Skriftstil"


msgid "Match my store"
msgstr "Samme som butikken min"


msgid "System default"
msgstr "Systemstandard"


msgid "Custom font"
msgstr "Egendefinert skrift"


msgid "Match my store borrows the font your theme already uses around the search box."
msgstr "Samme som butikken min låner skriften temaet ditt allerede bruker rundt søkefeltet."


msgctxt "example font stack"
msgid "e.g. Georgia, serif"
msgstr "f.eks. Georgia, serif"


msgid "Only used when Custom font is selected."
msgstr "Brukes bare når Egendefinert skrift er valgt."


msgid "What to search"
msgstr "Hva søket skal omfatte"


msgid "Include"
msgstr "Inkluder"


msgid "Products"
msgstr "Produkter"


msgid "always indexed"
msgstr "indekseres alltid"


msgid "Pages"
msgstr "Sider"


msgid "Blog posts"
msgstr "Blogginnlegg"


#. translators: %s: the technical term "noindex", wrapped in <em>. Do not translate it.
msgid "Pages and posts count towards the same allowance as your products, so switching them off frees it up for your catalogue. Your products always come first and are never displaced by them. Private, password-protected and unpublished content is never indexed, and we honour %s set by Yoast SEO or Rank Math (per item, per content type, or site-wide)."
msgstr "Sider og innlegg teller mot den samme kvoten som produktene dine, så slår du dem av, frigjør du plass til katalogen. Produktene dine kommer alltid først og fortrenges aldri av dem. Privat, passordbeskyttet og upublisert innhold indekseres aldri, og vi respekterer %s som er satt av Yoast SEO eller Rank Math (per element, per innholdstype eller for hele nettstedet)."


msgid "Search results page"
msgstr "Søkeresultatside"


msgid "Enhance the product search results page with NitroSearch results and filters"
msgstr "Forbedre søkeresultatsiden for produkter med resultater og filtre fra NitroSearch"


msgid "Privacy &amp; credit"
msgstr "Personvern og kreditering"


msgid "Search usage data"
msgstr "Søkebruksdata"


msgid "Share anonymous search usage counts with NitroSearch"
msgstr "Del anonyme tellinger av søkebruk med NitroSearch"


msgid "Counts searches, result totals and result clicks on your store's search — cookieless and anonymous, with no shopper identifiers, no IP addresses and nothing stored in the shopper's browser. Used to improve result ranking and to power your search analytics. Untick to stop sending immediately."
msgstr "Teller søk, antall resultater og resultatklikk i butikkens søk – anonymt og uten informasjonskapsler, uten identifikatorer for kundene, uten IP-adresser og uten at noe lagres i kundens nettleser. Brukes til å forbedre rangeringen av resultatene og til å drive søkeanalysen din. Fjern avmerkingen for å stoppe sendingen umiddelbart."


msgid "Powered-by credit"
msgstr "«Levert av»-kreditering"


msgid "Show a small “Powered by NitroSearch” credit, linking to nitrosearch.io"
msgstr "Vis en liten «Levert av NitroSearch»-kreditering med lenke til nitrosearch.io"


#. translators: %s: the URL https://nitrosearch.io, wrapped in <code>.
msgid "Off by default, and entirely your choice. Turning it on adds a small credit in the search box and one line in your site footer, both linking to %s — a normal, followed link. Nothing is added to your site unless you tick this. Thank you if you do."
msgstr "Av som standard, og helt opp til deg. Slår du den på, legges det til en liten kreditering i søkefeltet og én linje i bunnteksten på nettstedet ditt, begge med lenke til %s – en vanlig lenke som følges. Ingenting legges til på nettstedet ditt med mindre du merker av her. Tusen takk om du gjør det."


msgid "Advanced"
msgstr "Avansert"


msgid "Search box selector"
msgstr "Velger for søkefeltet"


msgctxt "example CSS selector"
msgid "e.g. input.my-theme-search"
msgstr "f.eks. input.my-theme-search"


msgid "Optional CSS selector for your theme's search input. Leave blank to auto-detect."
msgstr "Valgfri CSS-velger for søkefeltet i temaet ditt. La feltet stå tomt for automatisk gjenkjenning."


msgid "Save design"
msgstr "Lagre design"


#. translators: %s: the error detail returned by the server.
msgid "Connect failed: %s"
msgstr "Tilkoblingen mislyktes: %s"


msgid "unknown error"
msgstr "ukjent feil"


msgid "Connected and verified."
msgstr "Tilkoblet og bekreftet."


msgid "Connected. Confirming control of your site — this can take a moment. Use “Check status” below if it doesn’t update."
msgstr "Tilkoblet. Bekrefter kontroll over nettstedet ditt – dette kan ta en liten stund. Bruk «Sjekk status» nedenfor hvis det ikke oppdaterer seg."


#. translators: %s: number of products.
msgid "Syncing %s product in the background, then your pages and posts."
msgid_plural "Syncing %s products in the background, then your pages and posts."
msgstr[0] "Synkroniserer %s produkt i bakgrunnen, deretter sidene og innleggene dine."
msgstr[1] "Synkroniserer %s produkter i bakgrunnen, deretter sidene og innleggene dine."


#. translators: %s: number of products.
msgid "Syncing %s product in the background."
msgid_plural "Syncing %s products in the background."
msgstr[0] "Synkroniserer %s produkt i bakgrunnen."
msgstr[1] "Synkroniserer %s produkter i bakgrunnen."


msgid "Verified!"
msgstr "Bekreftet!"


#. translators: 1: number of items in the search index, 2: number of changes waiting to sync.
msgid "%1$s search results indexed · %2$s pending."
msgstr "%1$s søkeresultater indeksert · %2$s venter."


msgid "Still confirming control of your site — please try again in a moment."
msgstr "Bekrefter fremdeles kontroll over nettstedet ditt – prøv igjen om litt."


msgid "Design saved."
msgstr "Designet er lagret."


msgid "Saved. Removing your pages and blog posts from your index in the background."
msgstr "Lagret. Fjerner sidene og blogginnleggene dine fra indeksen i bakgrunnen."


msgid "Saved. Removing your pages from your index in the background."
msgstr "Lagret. Fjerner sidene dine fra indeksen i bakgrunnen."


msgid "Saved. Removing your blog posts from your index in the background."
msgstr "Lagret. Fjerner blogginnleggene dine fra indeksen i bakgrunnen."


msgid "Saved. Indexing your pages and blog posts in the background."
msgstr "Lagret. Indekserer sidene og blogginnleggene dine i bakgrunnen."


msgid "Saved. Indexing your pages in the background."
msgstr "Lagret. Indekserer sidene dine i bakgrunnen."


msgid "Saved. Indexing your blog posts in the background."
msgstr "Lagret. Indekserer blogginnleggene dine i bakgrunnen."


msgid "Disconnected."
msgstr "Frakoblet."


msgid "This store is already claimed to a NitroSearch account."
msgstr "Denne butikken er allerede knyttet til en NitroSearch-konto."


#. translators: "Refresh status" is the button of that name on this screen — translate it the same way.
msgid "We couldn’t confirm control of your site yet — click \"Refresh status\" first, then try again."
msgstr "Vi fikk ikke bekreftet kontroll over nettstedet ditt ennå – klikk først på «Oppdater status», og prøv deretter igjen."


#. translators: "Refresh status" is the button of that name on this screen — translate it the same way.
msgid "Your site needs re-checking — click \"Refresh status\", then try again."
msgstr "Nettstedet ditt må sjekkes på nytt – klikk på «Oppdater status», og prøv igjen."


msgid "Too many attempts — please wait a minute and try again."
msgstr "For mange forsøk – vent et minutt og prøv igjen."


msgid "Could not create a manage link. Please try again."
msgstr "Kunne ikke opprette en administrasjonslenke. Prøv igjen."


msgid "Insufficient permissions."
msgstr "Utilstrekkelige rettigheter."


#. translators: %s: the linked brand name "NitroSearch".
msgid "Search powered by %s"
msgstr "Søk levert av %s"


msgid "Refine results"
msgstr "Avgrens resultatene"


msgid "Refine"
msgstr "Avgrens"


msgid "In stock"
msgstr "På lager"


msgid "On sale"
msgstr "På tilbud"


msgid "Brand"
msgstr "Merke"


msgid "Category"
msgstr "Kategori"


msgid "View"
msgstr "Vis"


msgid "Add to cart"
msgstr "Legg i handlekurv"


msgid "Adding…"
msgstr "Legger til …"


msgid "Added ✓"
msgstr "Lagt til ✓"


msgid "Try again"
msgstr "Prøv igjen"


msgid "Searching…"
msgstr "Søker …"


msgid "Search is unavailable."
msgstr "Søket er utilgjengelig."


msgid "Search is unavailable right now."
msgstr "Søket er utilgjengelig akkurat nå."


msgid "No products found."
msgstr "Fant ingen produkter."


#. translators: %s: the shopper's search term.
msgid "No products found for “%s”."
msgstr "Fant ingen produkter for «%s»."


#. translators: %s: the shopper's search term.
msgid "Nothing found for “%s”."
msgstr "Fant ingenting for «%s»."


msgid "Search products…"
msgstr "Søk etter produkter …"


msgid "Close search"
msgstr "Lukk søket"


msgid "Product results"
msgstr "Produktresultater"


msgid "Recent searches"
msgstr "Nylige søk"


msgid "Clear"
msgstr "Tøm"


msgid "Start typing to search products…"
msgstr "Begynn å skrive for å søke etter produkter …"


msgid "Sale"
msgstr "Tilbud"


msgid "Out of stock"
msgstr "Ikke på lager"


msgid "Pages & posts"
msgstr "Sider og innlegg"


msgctxt "a website page, shown on a search result"
msgid "Page"
msgstr "Side"


msgctxt "a blog post, shown on a search result"
msgid "Article"
msgstr "Artikkel"


#. translators: %s: the search round-trip time in milliseconds.
msgctxt "unit: milliseconds"
msgid "%s ms"
msgstr "%s ms"


#. translators: %s: the brand name "NitroSearch".
msgid "Powered by %s"
msgstr "Levert av %s"


#. translators: 1: current page number, 2: total number of pages.
msgid "Page %1$s of %2$s"
msgstr "Side %1$s av %2$s"


msgid "← Prev"
msgstr "← Forrige"


msgid "Next →"
msgstr "Neste →"


msgctxt "button label"
msgid "Search"
msgstr "Søk"


#. translators: %s: number of products found (screen-reader announcement).
msgid "%s product found."
msgid_plural "%s products found."
msgstr[0] "%s produkt funnet."
msgstr[1] "%s produkter funnet."


#. translators: %s: total number of results.
msgid "See all %s result →"
msgid_plural "See all %s results →"
msgstr[0] "Se %s resultat →"
msgstr[1] "Se alle %s resultater →"


#. translators: 1: number of results, 2: the shopper's search term.
msgid "%1$s result for “%2$s”"
msgid_plural "%1$s results for “%2$s”"
msgstr[0] "%1$s resultat for «%2$s»"
msgstr[1] "%1$s resultater for «%2$s»"


#. translators: %s: number of results.
msgid "%s result"
msgid_plural "%s results"
msgstr[0] "%s resultat"
msgstr[1] "%s resultater"
